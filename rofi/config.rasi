configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

@theme "tokyo"

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 500;
    y-offset: -20;

    border-radius: 0px;
    border: 2px;
    border-color: @accent;

    background-color: rgba(16, 16, 17, 0.92);
}

mainbox {
    padding: 0px;
    background-color: @bg0;
}

inputbar {
    background-color: @bg1;
    border-radius: 1px;
    border: 1px;
    border-color: @bg3;

    padding: 8px 16px;
    spacing: 8px;
}

prompt {
    text-color: @cyan;
    background-color: transparent;
}

entry {
    text-color: @fg0;
    placeholder: "search";
    placeholder-color: @fg2;
    background-color: transparent;
}

listview {
    background-color: @bg0;
    margin: 10px 0 0;

    columns: 1;
    lines: 6;
    fixed-height: false;
}

element {
    padding: 10px 6px;
    spacing: 6px;
    border-radius: 1px;

    background-color: @bg0;
}

element normal urgent {
    text-color: @red;
}

element normal active {
    text-color: @blue;
}

element selected normal,
element selected active {
    background-color: rgba(75, 93, 84, 0.45);
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

message {
    margin: 12px 0 0;
    border-radius: 12px;
    border: 1px;
    border-color: @bg3;

    background-color: @bg1;
}

textbox {
    padding: 8px 24px;
    background-color: @bg1;
}
